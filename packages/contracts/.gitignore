# Build output (regenerated by `hardhat compile`)
artifacts/
cache/
typechain-types/
node_modules/

# Secrets: never commit a signing key or a wallet keyfile, wherever it was saved
.env
.env.*
*.key
*.pem
*keyfile*.json
*wallet*.json
arweave*.json
jwk*.json
*.progress.json

# Not ignored on purpose: deployments/artwork.json, deployments/<network>.json (public addresses and tx ids)
out/
cache_forge/
reports/*.tmp
